{
  "name": "@bradensbay/globals-shm",
  "version": "0.2.1",
  "description": "The native transport: one file-backed shared memory region, a double-buffered owning writer, and reader copies that are always exactly one commit, through Node-API so the V8 memory cage is never involved.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "native/prebuilds",
    "native/addon.c",
    "native/binding.gyp",
    "scripts/install.mjs",
    "README.md"
  ],
  "scripts": {
    "build:native": "cd native && node-gyp rebuild",
    "install": "node scripts/install.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianGRogers/globals.git",
    "directory": "packages/shm"
  }
}
