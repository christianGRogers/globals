{
  "name": "globals-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Synchronous reads of shared application state across Electron processes.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "typecheck": "tsc --build tsconfig.build.json --pretty",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:core": "npm run build && node scripts/run-tests.mjs",
    "soak": "npm run build && node packages/core/dist/test/soak/run-soak.js",
    "bench": "npm run build && node benchmarks/dist/read-latency.js",
    "lint": "npm run typecheck && node scripts/check-docs.mjs",
    "spike": "node spikes/run-spike.mjs",
    "chaos": "npm run build && node packages/core/dist/test/soak/run-chaos.js",
    "spike:electron": "node spikes/run-spike.mjs 01"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "electron": "^33.4.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianGRogers/globals.git"
  }
}
